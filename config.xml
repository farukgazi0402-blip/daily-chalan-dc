<?xml version='1.0' encoding='utf-8'?>
<widget id="com.faruk.dailychalandc" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <name>Daily Chalan DC</name>
    <description>Daily collection and poultry tracking app</description>
    <author email="support@example.com" href="https://github.com/">Faruk Gazi</author>
    <content src="index.html" />
    
    <!-- মূল অ্যাপ আইকন ও স্প্ল্যাশ স্ক্রিন কনফিগারেশন -->
    <icon src="icon.png" />

    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
    <preference name="orientation" value="default" />
    <preference name="fullscreen" value="false" />

    <!-- পিডিএফ ও শেয়ারিং প্লাগইন -->
    <plugin name="cordova-plugin-file" spec="^7.0.0" />
    <plugin name="cordova-plugin-x-socialsharing" spec="^6.0.4" />
    
    <!-- স্প্ল্যাশ স্ক্রিন কন্ট্রোল করার প্লাগইন -->
    <plugin name="cordova-plugin-splashscreen" spec="^6.0.1" />

    <platform name="android">
        <allow-intent href="market:*" />
        
        <!-- অ্যান্ড্রয়েড স্টোরেজ পারমিশন -->
        <preference name="AndroidPersistentFileLocation" value="Compatibility" />
        <edit-config file="app/src/main/AndroidManifest.xml" mode="merge" target="/manifest">
            <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
            <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
        </edit-config>

        <!-- রোবট আইকন বা ডিফল্ট স্প্ল্যাশ স্ক্রিন সরিয়ে আপনার লোগো দেখানোর সেটিংস -->
        <preference name="SplashScreen" value="screen" />
        <preference name="SplashScreenDelay" value="0" />
        <preference name="ShowSplashScreen" value="true" />
        <preference name="AutoHideSplashScreen" value="true" />
        <preference name="FadeSplashScreen" value="false" />
        <preference name="SplashScreenBackgroundColor" value="#ffffff" />
    </platform>
</widget>
